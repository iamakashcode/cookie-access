# Nginx reverse proxy for the single Next.js app.
# The whole product (marketing site, dashboard, and /api/*) is served by one
# Next process on port 7019. This config serves plain HTTP without SSL.
#
# Install as an Nginx site config, then run:
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name cookieaccess.com;

    location / {
        proxy_pass http://127.0.0.1:7019;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Slightly larger bodies for notice text / CSV, etc.
    client_max_body_size 100m;
}